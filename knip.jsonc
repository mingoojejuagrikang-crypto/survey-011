// knip 설정 — 미사용 파일·export·의존성 검출기 (Phase 0-b, 2026-08-10)
//
// 🔑 왜 knip인가: 미사용 판정을 grep에 맡기면 두 축으로 샌다 — 이름 기반 참조는 내용 검색에
//   안 걸리고[TEAMOPS-5], 호스트에 따라 gitignore된 파일을 건너뛴다[TEAMOPS-18].
//   knip은 모듈 그래프를 실제로 해석하므로 두 축 모두에서 자유롭다.
//
// 🔴 이 검사기는 「보고」용이다 — 릴리스 게이트(`check:release`)에 연결돼 있지 않다.
//   미사용 «판정»과 제거는 사람 몫이다: 동적 참조(page.evaluate 내 import 등)가 있을 수 있고,
//   오디오 3파일(useVoiceSession·audioRecorder·speech)은 리뷰 라운드 필수 대상이다.
//   실행: `npm run check:unused` (미사용이 있으면 exit 1 — 게이트 밖이라 배포엔 무영향)
{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // entry 는 적지 않는다 — 앱의 유일한 진입점 src/main.tsx(index.html이 참조)는 knip 기본
  // 패턴(`src/{index,main}.*`)이 잡고(명시하면 「redundant entry」 설정 힌트가 뜬다),
  // 테스트(tests/**)와 npm 스크립트가 부르는 scripts/*.mjs 는
  // playwright 플러그인·package.json 파싱이 자동으로 entry 에 넣는다.

  // page.evaluate 안의 브라우저 컨텍스트 동적 임포트(`import('/src/lib/…')`)는 Vite dev 서버가
  // 런타임에 해석하는 절대경로다. knip 에게 같은 매핑을 줘야 ①「미해석 임포트」 오탐이 사라지고
  // ②그 경로로만 쓰이는 export 가 「미사용」으로 잘못 잡히지 않는다.
  "paths": { "/src/*": ["src/*"] },

  // claude.ai/design 핸드오프 산출물 — 앱 빌드에 포함되지 않는 참고용 .jsx 스냅샷.
  // 앱 코드가 아니므로 미사용 검출 대상에서 뺀다(은폐가 아니라 스코핑).
  "ignore": ["design-handoff/**"],

  // probe 전용 config 도 플러그인이 인식해야 「미사용 파일」 오탐이 안 난다.
  // (playwright 플러그인 기본 패턴은 `playwright.config.ts` 만 본다)
  "playwright": {
    "config": ["playwright.config.ts", "playwright.probe.config.ts"]
  }
}
